{% extends "layouts/base.njk" %}
{% from "components/button.njk" import button %}
{% from "components/panel.njk" import panel %}

{% set title = "Admin | CP Gamejam" %}
{% set bodyClass = "min-h-screen bg-white text-slate-800" %}

{% block content %}
{% set tabs = [
    { id: "messages", label: "Beskeder" },
    { id: "holds", label: "Hold" },
    { id: "events", label: "Begivenheder" },
    { id: "settings", label: "Indstillinger" }
] %}

{# The tabs stay at the top while you scroll. Messages come first: that's what you're here for. #}
<header class="sticky top-0 z-10 bg-white border-b-4 border-black">
    <div class="max-w-4xl mx-auto px-4 py-3 flex flex-wrap items-center justify-between gap-3">
        <h1 class="text-xl font-bold uppercase tracking-widest">Admin</h1>
        <nav class="flex flex-wrap gap-2" role="tablist" aria-label="Admin">
            {% for tab in tabs %}
            <button type="button" role="tab" data-tab="{{ tab.id }}" aria-selected="{{ 'true' if loop.first else 'false' }}"
                class="text-sm font-bold uppercase tracking-widest py-2 px-4 border-2 border-black transition-colors {{ 'bg-black text-white' if loop.first else 'bg-white hover:bg-slate-100' }}">
                {{ tab.label }}
                {% if tab.id == "messages" %}
                <span id="pending-badge" class="hidden ml-1 bg-red-500 text-white px-2 py-0.5 text-xs"></span>
                {% endif %}
            </button>
            {% endfor %}
        </nav>
    </div>
</header>

<main class="max-w-4xl mx-auto px-4 py-8">
    <section data-panel="messages" role="tabpanel" class="space-y-8">
        {% call panel("Afventende beskeder", countId="pending-count") %}
        <div id="pending-list" class="space-y-3"></div>
        {% endcall %}

        {% call panel("Godkendte beskeder", countId="approved-count") %}
        <div id="approved-list" class="space-y-3"></div>
        {% endcall %}
    </section>

    <section data-panel="holds" role="tabpanel" class="space-y-8" hidden>
        {% call panel("Hold") %}
        <div id="holds-list" class="space-y-2"></div>
        <form id="holds-form" class="flex flex-wrap items-end gap-3">
            <label class="flex flex-col gap-1 text-sm">
                Antal hold
                <input id="holds-count" type="number" min="1" max="99" step="1" value="14" required
                    class="border-2 border-black px-3 py-2 w-28" />
            </label>
            {{ button("Lav nye koder til alle", type="submit") }}
            <a href="/admin/api/holds/pdf"
                class="bg-black text-white font-bold uppercase tracking-widest py-2 px-4 hover:bg-slate-800 transition-colors">Hent alle som PDF</a>
            <span id="holds-status" class="text-sm"></span>
        </form>
        <p class="text-xs text-slate-500">
            "Lav nye koder til alle" laver hold 1 til det antal du vælger, plus frivillig, og erstatter alle
            nuværende koder, ventetider og spærringer. Til ét hold kan du give en ny kode eller hente dets PDF på rækken.
            Ventetiden er tiden mellem et holds beskeder; frivillig har ingen, medmindre du sætter en.
        </p>
        {% endcall %}
    </section>

    <section data-panel="events" role="tabpanel" class="space-y-8" hidden>
        {% call panel("Begivenheder på uret") %}
        <div id="events-list" class="space-y-2"></div>
        <form id="event-form" class="flex flex-wrap items-end gap-3">
            <label class="flex flex-col gap-1 text-sm">
                Handling
                <select id="event-action" class="border-2 border-black px-3 py-2 bg-white">
                    <option value="confetti">Konfetti</option>
                    <option value="fanfare">Fanfare (lyd)</option>
                    <option value="tick">Tik (lyd, nedtællingen)</option>
                    <option value="beep">Bip (lyd, de sidste sekunder)</option>
                    <option value="dark">Mørk tilstand</option>
                </select>
            </label>
            <label class="flex flex-col gap-1 text-sm">
                Ved (TT:MM:SS)
                <input id="event-at" type="text" placeholder="00:10:00" class="border-2 border-black px-3 py-2 w-36" />
            </label>
            <label class="flex flex-col gap-1 text-sm">
                Til (TT:MM:SS)
                <input id="event-until" type="text" placeholder="00:00:01"
                    class="border-2 border-black px-3 py-2 w-36 disabled:opacity-40" />
            </label>
            {{ button("Tilføj", type="submit") }}
            <span id="event-status" class="text-sm"></span>
        </form>
        <p id="event-hint" class="text-sm"></p>
        <p class="text-xs text-slate-500">Tiderne er det, uret viser.</p>
        {% endcall %}
    </section>

    <section data-panel="settings" role="tabpanel" class="space-y-8" hidden>
        {% call panel("Indstillinger") %}
        <form id="config-form" class="flex flex-wrap items-end gap-3">
            <label class="flex flex-col gap-1 text-sm">
                Beskeder udløber efter (minutter)
                <input id="ttl-input" type="number" min="1" step="1" required
                    class="border-2 border-black px-3 py-2 w-40" />
            </label>
            <label class="flex flex-col gap-1 text-sm">
                Nedtælling til (dato og tid)
                <input id="target-input" type="datetime-local" required
                    class="border-2 border-black px-3 py-2" />
            </label>
            <div class="flex flex-col gap-1 text-sm">
                Maksimum for uret
                <div class="flex">
                    <input id="max-value-input" type="number" min="1" step="1" required aria-label="Maksimum for uret"
                        class="border-2 border-black px-3 py-2 w-28" />
                    <select id="max-unit-input" aria-label="Enhed for maksimum"
                        class="border-2 border-l-0 border-black px-3 py-2 bg-white">
                        <option value="days">dage</option>
                        <option value="hours">timer</option>
                        <option value="minutes">minutter</option>
                        <option value="seconds">sekunder</option>
                    </select>
                </div>
            </div>
            <label class="flex items-center gap-2 text-sm py-2">
                <input id="show-days-input" type="checkbox" class="w-5 h-5 accent-black" />
                Vis dage på uret
            </label>
            {{ button("Gem", type="submit") }}
            <span id="config-status" class="text-sm"></span>
        </form>
        {% endcall %}
    </section>
</main>
{% endblock %}

{% block scripts %}
<script src="/js/admin.js"></script>
{% endblock %}
