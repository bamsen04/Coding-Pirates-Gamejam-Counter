{% extends "layouts/base.njk" %}
{% from "components/button.njk" import button %}

{% set title = "Coding Pirates Gamejam" %}
{% set bodyClass = "scene-bg min-h-screen relative overflow-x-hidden md:overflow-hidden" %}

{% block bodyAttrs %} data-target-date="{{ targetDate }}" data-show-days="{{ 'true' if showDays else 'false' }}" data-max-ms="{{ maxMs }}" data-events="{{ events | dump }}"{% endblock %}

{% block head %}
<link rel="stylesheet" href="/css/index.css">
{% endblock %}

{% block content %}
{# The sea behind everything: sun (a moon at night), waves, a ship. See public/css/index.css #}
<div class="scenery" aria-hidden="true">
    <div class="waves"><i></i><i></i><i></i><i></i></div>
    <div class="sun"></div>
    <div class="stars"></div>
    <div class="ship hidden md:block"><i class="hull"></i><i class="mast"></i><i class="sail"></i><i class="skull"></i><i class="flag"></i></div>
</div>

<div class="md:hidden relative z-10 flex flex-col items-center gap-8 px-4 pt-10 pb-32 min-h-screen">
    <h1 class="title">Coding Pirates Gamejam</h1>
    <div id="clock-mobile" class="clock-display"></div>
    <div id="bubbles-mobile" class="w-full flex flex-col gap-10 pt-4"></div>
</div>

<div class="hidden md:grid relative z-10 h-screen grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] items-center gap-8 px-8 pt-28 pb-28">
    <h1 class="title absolute top-6 left-1/2 -translate-x-1/2 w-full px-4">Coding Pirates Gamejam</h1>

    <div id="bubbles-left" class="h-full min-w-0 flex flex-col justify-evenly items-start gap-6"></div>

    <div id="clock" class="clock-display"></div>

    <div id="bubbles-right" class="h-full min-w-0 flex flex-col justify-evenly items-end gap-6"></div>
</div>

<button id="fab" type="button"
    class="px fixed bottom-6 left-1/2 -translate-x-1/2 z-40 w-[72px] h-[72px] bg-accent text-onaccent font-pixel text-3xl flex items-center justify-center hover:brightness-110 active:translate-y-0.5">+</button>

{# Blocks the page until clicked; the click lets the browser play sound. See src/client/start.ts #}
<div id="start-blocker" class="scene-bg fixed inset-0 z-[100] flex items-center justify-center px-4">
    <div class="px px-panel w-full max-w-md p-8 flex flex-col items-center gap-6 text-center">
        <h2 class="font-pixel text-base uppercase leading-relaxed">Coding Pirates Gamejam</h2>
        <button id="start-button" type="button" class="px px-btn px-btn-primary">Tryk for at starte</button>
        <p class="opacity-75">Klik for at aktivere lyd</p>
    </div>
</div>

<div id="message-modal" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center px-4">
    <div class="px px-panel w-full max-w-sm p-6 relative">
        <button id="message-close" type="button" aria-label="Luk"
            class="absolute top-2 right-3 font-pixel text-lg leading-none px-1 hover:text-accent">&times;</button>

        {# Step 1: type your hold's code, or say you're not on a hold. Nothing else is shown until you do. #}
        <div id="gate" class="hidden space-y-5">
            <h2 class="font-pixel text-sm uppercase leading-relaxed pr-6">Er du på et hold?</h2>

            <form id="hold-form" class="space-y-4">
                <input id="hold-token" type="text" maxlength="12" required placeholder="Skriv din kode"
                    autocomplete="off" autocapitalize="characters" spellcheck="false"
                    class="px-field w-full text-center text-xl uppercase tracking-widest" />
                <p id="hold-error" class="text-accent"></p>
                {{ button("Fortsæt", type="submit", full=true) }}
            </form>

            <p class="text-center opacity-70">eller</p>

            <button id="no-hold" type="button" class="px px-btn w-full">Jeg er ikke på et hold</button>
        </div>

        {# Step 2: the message. #}
        <div id="compose" class="hidden">
            <h2 class="font-pixel text-sm uppercase leading-relaxed pr-6 mb-4">Send en besked</h2>

            <div class="flex items-center justify-between gap-3 mb-4">
                <span>Du sender som <strong id="sender-label"></strong></span>
                <button id="sender-switch" type="button" class="underline hover:text-accent"></button>
            </div>

            <form id="message-form" class="space-y-4">
                <input id="message-author" type="text" maxlength="30" required placeholder="Dit navn" class="px-field w-full" />
                <textarea id="message-text" maxlength="200" required rows="3" placeholder="Din besked"
                    class="px-field w-full resize-none"></textarea>
                <p id="message-error" class="text-accent"></p>
                {# Only people without a hold have to pass the captcha. #}
                {% if turnstile.enabled %}
                <div id="turnstile-box" class="cf-turnstile" data-sitekey="{{ turnstile.siteKey }}"></div>
                {% endif %}
                <p id="message-note" class="opacity-75"></p>
                {{ button("Send", id="message-send", type="submit", full=true) }}
            </form>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
{% if turnstile.enabled %}
<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
{% endif %}
<script type="module" src="/js/index.js"></script>
{% endblock %}
