{% extends "layouts/base.njk" %}
{% from "components/button.njk" import button %}

{% set title = "Coding Pirates Gamejam" %}
{% set bodyClass = "min-h-screen bg-white relative overflow-x-hidden md:overflow-hidden" %}
{% block bodyAttrs %} data-target-date="{{ targetDate }}" data-show-days="{{ 'true' if showDays else 'false' }}" data-max-ms="{{ maxMs }}" data-events="{{ events | dump }}"{% endblock %}

{% block head %}
<link rel="stylesheet" href="/css/index.css">
{% endblock %}

{% block content %}
<div class="absolute inset-0 bg-[radial-gradient(circle_at_center,_color-mix(in_srgb,var(--color-black)_4%,transparent)_0%,_var(--color-white)_70%)]">
</div>

<div class="md:hidden relative flex flex-col items-center gap-6 px-4 pt-10 pb-32 min-h-screen">
    <h1 class="text-slate-700 text-3xl font-bold tracking-[0.15em] uppercase text-center">
        Coding Pirates Gamejam
    </h1>
    <div id="clock-mobile"
        class="clock-display text-4xl leading-none bg-white border-4 border-red-400 px-4 py-3 flex items-center justify-center">
    </div>
    <div id="bubbles-mobile" class="w-full flex flex-col gap-3"></div>
</div>

<div
    class="hidden md:grid relative h-screen grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] items-center gap-8 px-8 pt-28 pb-28">
    <h1
        class="absolute top-6 left-1/2 -translate-x-1/2 w-full text-slate-700 text-3xl md:text-5xl font-bold tracking-[0.2em] uppercase text-center px-4">
        Coding Pirates Gamejam
    </h1>

    <div id="bubbles-left" class="h-full min-w-0 flex flex-col justify-evenly items-start gap-4"></div>

    <div id="clock"
        class="rounded-xl clock-display clock-desktop leading-none bg-white border-4 border-red-400 px-10 py-6 flex items-center justify-center">
    </div>

    <div id="bubbles-right" class="h-full min-w-0 flex flex-col justify-evenly items-end gap-4"></div>
</div>

<button id="fab" type="button"
    class="rounded-xl fixed bottom-6 left-1/2 -translate-x-1/2 z-40 w-16 h-16 bg-black text-white text-3xl font-bold border-2 border-black flex items-center justify-center hover:bg-slate-800 transition-colors">+</button>

{# Blocks the page until clicked; the click lets the browser play sound. See src/client/start.ts #}
<div id="start-blocker" class="fixed inset-0 z-[100] bg-white flex flex-col items-center justify-center gap-6 px-4">
    <h2 class="text-slate-700 text-2xl md:text-4xl font-bold tracking-[0.15em] uppercase text-center">
        Coding Pirates Gamejam
    </h2>
    <button id="start-button" type="button"
        class="bg-black text-white font-bold uppercase tracking-widest py-3 px-8 text-lg hover:bg-slate-800 transition-colors">Tryk
        for at starte</button>
    <p class="text-sm text-slate-500 text-center">Klik for at aktivere lyd</p>
</div>

<div id="message-modal"class="hidden fixed inset-0 bg-black/40 z-50 flex items-center justify-center px-4">
    <div class="bg-white border-4 border-black w-full max-w-sm p-6 relative">
        <button id="message-close" type="button"
            class="absolute top-2 right-2 text-2xl leading-none px-2 hover:text-red-500">&times;</button>
        <h2 class="text-lg font-bold uppercase tracking-widest mb-4">Send en besked</h2>
        <form id="message-form" class="space-y-3">
            <input id="message-author" type="text" maxlength="30" required placeholder="Dit navn"
                class="w-full border-2 border-black px-3 py-2 text-sm" />
            <textarea id="message-text" maxlength="200" required rows="3" placeholder="Din besked"
                class="w-full border-2 border-black px-3 py-2 text-sm resize-none"></textarea>
            <p id="message-error" class="text-sm text-red-500"></p>
            {% if turnstile.enabled %}
            <div class="cf-turnstile" data-sitekey="{{ turnstile.siteKey }}"></div>
            {% endif %}
            {{ button("Send", type="submit", full=true) }}
        </form>
    </div>
</div>
{% endblock %}

{% block scripts %}
{% if turnstile.enabled %}
<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
{% endif %}
<script type="module" src="/js/index.js"></script>
{% endblock %}
