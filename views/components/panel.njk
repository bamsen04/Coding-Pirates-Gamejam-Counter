{# A window on the admin page, with a heading. Pass `countId` to get a counter next to the heading. #}
{% macro panel(title, countId="") %}
<section class="px px-panel p-5 space-y-4">
    {% if countId %}
    <div class="flex items-center justify-between gap-3">
        <h2 class="font-pixel text-xs uppercase leading-relaxed">{{ title }}</h2>
        <span id="{{ countId }}" class="font-pixel text-xs"></span>
    </div>
    {% else %}
    <h2 class="font-pixel text-xs uppercase leading-relaxed">{{ title }}</h2>
    {% endif %}
    {{ caller() }}
</section>
{% endmacro %}
