{# A pixel button. `variant`: primary (red, the default), ok (green) or plain. `full` makes it full width. #}
{% macro button(label, id="", type="button", full=false, variant="primary", class="") %}
<button {% if id %}id="{{ id }}" {% endif %}type="{{ type }}"
    class="px px-btn {% if variant != 'plain' %}px-btn-{{ variant }} {% endif %}{{ 'w-full' if full }} {{ class }}">{{ label }}</button>
{% endmacro %}
