{# Solid black button. Use `full` for a full-width one, `class` to add extra classes. #}
{% macro button(label, id="", type="button", full=false, class="") %}
<button {% if id %}id="{{ id }}" {% endif %}type="{{ type }}"
    class="{{ 'w-full py-2' if full else 'py-2 px-4' }} bg-black text-white font-bold uppercase tracking-widest hover:bg-slate-800 transition-colors {{ class }}">{{ label }}</button>
{% endmacro %}
