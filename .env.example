# Database. Use long random values in production.
# These are only applied when the database volume is first created;
# changing them later means `docker compose down -v` (which wipes the data).
MYSQL_ROOT_PASSWORD="<random password>"
MYSQL_PASSWORD="<random password>"
# Optional, default to "gamejam"
# MYSQL_USER="gamejam"
# MYSQL_DATABASE="gamejam"

# The site key is public (it's shown in the page); the secret key must stay private.
# Both come from the same Turnstile widget in Cloudflare. Leave the site key out to use the default.
TURNSTILE_SITE_KEY="<cloudflare turnstile site key>"
TURNSTILE_SECRET_KEY="<cloudflare turnstile secret key>"
# Set to "true" to skip the Turnstile check (local development only)
DISABLE_TURNSTILE="false"

# Passkeys are bound to these. In production set them to your real domain / origin.
# ORIGIN is also the address the hold PDFs print and link to with a QR code,
# e.g. ORIGIN="https://countdown.gamejamkbh.dk" and RP_ID="countdown.gamejamkbh.dk".
RP_ID="localhost"
ORIGIN="http://localhost:3000"

# Set to "true" when the app runs behind a reverse proxy (Caddy, nginx). Without it every visitor
# looks like the proxy's address, and the one-message-per-10-minutes limit for people without a
# hold would apply to everyone at once.
TRUST_PROXY="false"

# Public IP addresses you trust, comma-separated (e.g. the venue's: what "what is my ip" shows from the
# venue Wi-Fi). They get 5 times the login rate limits, counted per browser instead of for the whole
# address, so one person typing a wrong code too often can't lock out everyone else.
# Needs TRUST_PROXY="true" behind a reverse proxy, or every address looks like the proxy's.
ALLOWED_IPS=""
