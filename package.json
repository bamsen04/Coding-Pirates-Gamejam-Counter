{
  "name": "gamejam-counter",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "license": "MIT",
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/bun": "latest",
    "@types/express": "^5.0.6",
    "@types/nunjucks": "^3.2.6",
    "tailwindcss": "^4.3.3"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "scripts": {
    "server": "bun run src/index.ts",
    "enroll": "bun run scripts/enroll.ts",
    "test": "bun test",
    "build:css": "tailwindcss -i src/styles/app.css -o public/app.css --minify",
    "dev:css": "tailwindcss -i src/styles/app.css -o public/app.css --watch",
    "build:js": "bun build src/client/index.ts src/client/admin.ts src/client/admin-login.ts src/client/admin-enroll.ts --outdir public/js --minify",
    "dev:js": "bun build src/client/index.ts src/client/admin.ts src/client/admin-login.ts src/client/admin-enroll.ts --outdir public/js --watch",
    "build": "bun run build:css && bun run build:js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/client"
  },
  "dependencies": {
    "@simplewebauthn/server": "^14.0.3",
    "express": "^5.2.1",
    "nunjucks": "^3.2.4",
    "qrcode-generator": "^2.0.4"
  }
}
